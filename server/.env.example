# Copy this file, rename the copy to .env, and fill in the real values.
# .env is ignored by git, so your secrets never get uploaded.

# Your Neon connection string (from the Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Your live Vercel site, so it's allowed to use the API (leave empty locally)
CLIENT_URL=

# Stripe secret key, from the Stripe dashboard (Test mode) -> Developers -> API keys.
# Starts with sk_test_
STRIPE_SECRET_KEY=sk_test_your_key_here

# Proves webhook messages really come from Stripe. Starts with whsec_
# Locally: printed by "stripe listen". Live: from the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
